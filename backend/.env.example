# Copiar como .env (el instalador lo hace solo y genera SECRET_KEY real).
DEBUG=True
SECRET_KEY=
# Cifra secretos de integraciones guardados en la base (credenciales del proveedor de factura electrónica, etc.).
CLAVE_CIFRADO=
# desarrollo | produccion  (produccion: waitress + build del frontend)
MODO=desarrollo

# Puertos (el instalador busca los siguientes libres y los guarda acá)
PUERTO_API=9006
PUERTO_WEB=5206

# Solo con DEBUG=False (lista separada por comas)
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Base de datos: sqlite (desarrollo, por defecto) o postgres (producción; se migra desde el panel sin perder datos)
DB_MOTOR=sqlite
DB_NOMBRE=
DB_USUARIO=
DB_CONTRASENA=
DB_SERVIDOR=
DB_PUERTO=

# Usuario administrador fijo de la PLATAFORMA (lo crea/restablece el instalador en cada instalación)
ADMIN_PLATAFORMA_USUARIO=admin
ADMIN_PLATAFORMA_CONTRASENA=Koape.Admin.2026
ADMIN_PLATAFORMA_CORREO=

# Respaldos
RESPALDOS_A_CONSERVAR=4
# Copia extra en otro disco o carpeta de red (vacío = sin copia)
DIR_RESPALDOS_COPIA=
HORA_RESPALDO=03:10

# Seguridad de ingreso
VIGENCIA_TOKEN_HORAS=12
INTENTOS_INGRESO_MAXIMOS=5
MINUTOS_BLOQUEO_INGRESO=15
LIMITE_INGRESO=10/min
LIMITE_CAMBIO_CONTRASENA=10/hour
LIMITE_PIN_PORTAL=10/hour
LIMITE_RECUPERAR_CONTRASENA=10/hour
# Cantidad de proxies delante del backend (1 en el servidor con nginx/Caddy; vacío en desarrollo)
NUM_PROXIES=

# Correo para el PIN del portal de abonados. Sin EMAIL_HOST, los correos quedan como archivos en datos/correos/.
# EMAIL_HOST=smtp.ejemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=avisos@ejemplo.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# CORREO_REMITENTE=Koape Aguateras <avisos@ejemplo.com>
